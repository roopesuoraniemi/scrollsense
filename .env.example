# Copy to .env and fill in. Use a key on a billing-enabled (paid) project:
# paid-tier prompts are not used to improve Google's products.
GEMINI_API_KEY=

# Bearer token for every /api route; required before tunnelling the server
SCROLLSENSE_TOKEN=

# Optional overrides
# GEMINI_PIPELINE=one_call            # one_call (about 3 s per Short) or two_stage (20-30 s, full transcript)
# GEMINI_MODEL=gemini-3.5-flash-lite  # default for one_call; two_stage defaults to gemini-4-hydrogen
# GEMINI_THINKING_OFF=1               # one_call only; gemini-3.5-flash-lite rejects it
# GEMINI_MAX_WATCH_S=30               # watch at most the first 30 s of a video (0 = all of it)

# Set to 1 to run the UI with placeholder output (no API calls)
# SCROLLSENSE_MOCK=1
