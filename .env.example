# Copy to .env and fill in. Use a key on a billing-enabled (paid) project:
# paid-tier prompts are not used to improve Google's products.
GEMINI_API_KEY=

# Bearer token for every /api route; required before tunnelling the server
SCROLLSENSE_TOKEN=

# Optional overrides
# GEMINI_MODEL=gemini-4-hydrogen      # fastest; alternatives: gemini-4-argon, gemini-4-carbon (≈4x slower, likely most capable)

# Set to 1 to run the UI with placeholder output (no API calls)
# SCROLLSENSE_MOCK=1

# Web demo: 1 = a fresh Gemini run on each viewer's first view of a Short (results arrive after
# the video, not from the cache), capped per viewer and per server run
# SCROLLSENSE_LIVE_INFERENCE=1
# SCROLLSENSE_WORKERS=6
# SCROLLSENSE_RUNS_PER_VIEWER=40
# SCROLLSENSE_RUNS_TOTAL=400
